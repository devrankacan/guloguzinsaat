# Admin panel login credentials (used on first run to bootstrap the account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random long string used to sign admin session cookies. Generate one with:
# openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string

# Shared secret checked on incoming Instagram webhook requests (from IFTTT).
# Generate one with: openssl rand -hex 24
INSTAGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-string
